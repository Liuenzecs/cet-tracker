# Database
DATABASE_URL=sqlite:///../../data/cet_tracker.db

# Server
API_HOST=127.0.0.1
API_PORT=8000

# AI Vocabulary Normalizer (optional)
# Set AI_NORMALIZER_ENABLED=true and configure provider to enable AI-powered
# markdown-to-structured-JSON conversion on the import page.
# AI features are OPTIONAL. Local parser works without any API key.
AI_NORMALIZER_ENABLED=false
AI_PROVIDER=deepseek
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-chat
AI_TIMEOUT_SECONDS=30
